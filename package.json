{
  "name": "school-theatre-manager",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build apps/client",
    "start": "node scripts/dev.mjs start",
    "lint": "eslint apps packages",
    "typecheck": "node packages/core/scripts/make-pg-schema.mjs --check && next typegen apps/client && tsc -p apps/client --noEmit && tsc -p packages/core --noEmit && tsc -p apps/server --noEmit",
    "db:generate": "node packages/core/scripts/make-pg-schema.mjs && drizzle-kit generate --config packages/core/drizzle.config.ts && drizzle-kit generate --config packages/core/drizzle.pg.config.ts",
    "db:studio": "drizzle-kit studio --config packages/core/drizzle.config.ts",
    "server:build": "esbuild server=apps/server/src/index.ts stm-tool=apps/server/src/tool.ts --bundle --platform=node --target=node22 --format=cjs --outdir=apps/server/dist --out-extension:.js=.cjs --external:better-sqlite3 --tsconfig=apps/server/tsconfig.json --log-level=warning",
    "server:dev": "npm run server:build && node apps/server/dist/server.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hono/node-server": "^1.19.17",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^7.0.1",
    "@tanstack/react-table": "^9.3.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.16",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "School Theatre Manager: shows, inventory, rentals and programs for school theatre programs.",
  "engines": {
    "node": ">=22"
  }
}
